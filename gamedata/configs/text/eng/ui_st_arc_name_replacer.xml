<string_table>
    <!-- Menu Title in MCM Sidebar -->
    <string id="ui_mcm_menu_arc_name_replacer">
        <text>Arc's Name Replacer</text>
    </string>
    <string id="ui_mcm_arc_name_replacer_title">
        <text>Settings</text>
    </string>
	
	<string id="ui_mcm_arc_name_replacer_faction_title">
        <text>Factions</text>
    </string>
    
    <!-- Slider Labels -->
    <string id="ui_mcm_arc_name_replacer_spawn_chance">
        <text>Spawn Chance (%)</text>
    </string>
    <string id="ui_mcm_arc_name_replacer_spawn_chance_desc">
        <text>Percentage probability that a special name will appear.</text>
    </string>
	
	<string id="ui_mcm_arc_name_replacer_generic_message_cooldown">
        <text>Generic Message Cooldown (seconds)</text>
    </string>
    <string id="ui_mcm_arc_name_replacer_generic_message_cooldown_desc">
        <text>Minimum time between generic PDA alerts. Special named stalkers always notify regardless of this cooldown.</text>
    </string>
	<string id="ui_mcm_arc_name_replacer_initial_spawn_chance">
        <text>New Game spawn Chance (%)</text>
    </string>
    <string id="ui_mcm_arc_name_replacer_initial_spawn_chance_desc">
        <text>On a new game, every stalker in the world (all maps) gets one roll at this chance to receive a special name. Separate from the regular spawn chance. Only applies at the start of a new game.</text>
    </string>

    
    <!-- Checkbox Labels -->
    <string id="ui_mcm_arc_name_replacer_enable_messages">
        <text>Enable PDA Alerts</text>
    </string>
    <string id="ui_mcm_arc_name_replacer_enable_messages_desc">
        <text>Toggle to turn on/off PDA notifications.</text>
    </string>
    <string id="ui_mcm_arc_name_replacer_enable_death_messages">
        <text>Enable Death Alerts</text>
    </string>
    <string id="ui_mcm_arc_name_replacer_enable_death_messages_desc">
        <text>Toggle to turn on/off notifications when you kill a renamed stalker.</text>
    </string>
	<string id="ui_mcm_arc_name_replacer_debug_enabled">
        <text>Enable Debug Logging</text>
    </string>
	<string id="ui_mcm_arc_name_replacer_debug_enabled_desc">
        <text>Prints the remaining names in the pool and the current cooldown status to the log every 10 seconds.</text>
    </string>
    <string id="ui_mcm_arc_name_replacer_enable_map_markers">
        <text>Enable Map Markers</text>
    </string>
    <string id="ui_mcm_arc_name_replacer_enable_map_markers_desc">
        <text>Toggle to show a map marker for renamed stalkers until you meet or kill them.</text>
    </string>
	
	<string id="ui_mcm_arc_name_replacer_reset_name_pool">
		<text>Reset name pool</text>
	</string>
	<string id="ui_mcm_arc_name_replacer_reset_name_pool_desc">
		<text>Rebuilds the name pool from names.txt, excluding names already used by stalkers in this save.</text>
	</string>


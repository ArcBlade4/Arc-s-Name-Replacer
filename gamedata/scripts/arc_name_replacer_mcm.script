--=====================================================
-- TIME HELPERS
--=====================================================

local function ctime_to_table(t)
    local y, m, d, h, mi, s, ms = 0, 0, 0, 0, 0, 0, 0
    y, m, d, h, mi, s, ms = t:get(y, m, d, h, mi, s, ms)
    return { y, m, d, h, mi, s, ms }
end

local function ctime_from_table(tb)
    local t = game.CTime()
    t:set(tb[1], tb[2], tb[3], tb[4], tb[5], tb[6], tb[7])
    return t
end

-- "just now" / "5h ago" / "3d ago"
local function time_ago(tb)
    if not tb then return game.translate_string("ui_anr_tracker_never") end
    local secs = game.get_game_time():diffSec(ctime_from_table(tb))
    local hours = math.floor(secs / 3600)
    if hours < 1 then return game.translate_string("ui_anr_tracker_just_now") end
    if hours < 24 then return hours .. "h " .. game.translate_string("ui_anr_tracker_ago") end
    return math.floor(hours / 24) .. "d " .. game.translate_string("ui_anr_tracker_ago")
end

local function seconds_since(tb)
    if not tb then return math.huge end
    return game.get_game_time():diffSec(ctime_from_table(tb))
end


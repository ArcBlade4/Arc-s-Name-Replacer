--=====================================================
-- STATE VARIABLES
--=====================================================
local donator_pool = {}
local processed_npcs = {}
local renamed_npcs = {}
local last_generic_message_time = 0 -- time of the last generic (non-special) rename message
local last_debug_time = 0 -- time of the last debug print
local spawn_chance = 1
local enable_messages = false
local file_found = false
local is_enabled = true
local enable_death_messages = false
local generic_message_cooldown = 2 -- seconds between generic rename messages, from mcm
local debug_enabled = false -- prints donator pool size + cooldown status to the log, from mcm
local enable_map_markers = true -- whether renamed npcs get a map marker, from mcm
local MARKER_SPOT_TYPE = "anr_special_location"
local MARKER_HINT = "Someone special"

--=====================================================
-- MESSAGES AND SPECIAL NAMES
--=====================================================


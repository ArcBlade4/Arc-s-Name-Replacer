--=====================================================
-- MAP MARKERS
--=====================================================

local function is_friendly_or_neutral(npc)
    return npc:relation(db.actor) ~= game_object.enemy
end

local function add_marker(id)
    if not enable_map_markers then return end
    level.map_add_object_spot(id, MARKER_SPOT_TYPE, MARKER_HINT)
end

local function remove_marker(id)
    level.map_remove_object_spot(id, MARKER_SPOT_TYPE, MARKER_HINT)
end

-- Re-add markers for any renamed NPCs still alive after a level transition
-- or save load, in case spots don't survive that implicit save/load cycle
-- on their own.
local function refresh_markers()
    for name, data in pairs(renamed_npcs) do
        add_marker(data.id)
    end
end

-- Player talked to a renamed NPC -> drop their marker
local function npc_on_use(npc, who)
    if npc and renamed_npcs[npc:name()] then
        remove_marker(npc:id())
        renamed_npcs[npc:name()] = nil
    end
end

local function npc_on_fighting_actor(npc)
    if npc and renamed_npcs[npc:name()] then
        remove_marker(npc:id())
    end
end


--=====================================================
-- NAME POOL / FILE LOADING
--=====================================================

-- patterns that count as a "generic" npc, safe to rename
local generic_patterns = {
    "default", "regular", "tier", "squad",
    "sim_npc", "alpha", "weak", "normal", "strong"
}

-- load names
local function load_names()
    local engine_root_path = getFS():update_path("$fs_root$", "")
    local file_path = engine_root_path .. "names.txt"
    local file = io.open(file_path, "r")

    if file then -- check if file exists
        printf("ANR: Found names.txt, loading names...")
        for line in file:lines() do -- read all lines
            local clean_name = line:gsub("^%s*(.-)%s*$", "%1")
            if clean_name ~= "" then
                table.insert(donator_pool, clean_name)
            end
        end
        file:close()
        printf("ANR: Successfully loaded " .. #donator_pool .. " names from text file.")
        file_found = true
    else -- error message for if file not found
        printf("ANR: WARNING! names.txt not found. looked here: " .. tostring(file_path))
    end
end

-- makes name load once
local function ensure_names_loaded()
    if not file_found then
        load_names()
    end
end

-- checks profile name against the generic patterns list
local function is_generic_profile(profile)
    for _, pattern in ipairs(generic_patterns) do
        if string.find(profile, pattern) then
            return true
        end
    end
    return false
end

-- grabs a random name from the pool and removes it
local function take_random_name()
    local idx = math.random(#donator_pool) -- pick random index
    local chosen_name = donator_pool[idx] -- get name at that index
    table.remove(donator_pool, idx) -- remove it so it can't be reused
    return chosen_name
end

--=====================================================
-- MCM (MOD CONFIGURATION MENU)
--=====================================================

--mcm stuff
function on_mcm_load()
    op = {
        id = "arc_name_replacer",
        sh = true,
        gr = {
            -- Title text banner mapping
            { id = "title", type = "slide", link = "ui_options_slider_player", text = "ui_mcm_arc_name_replacer_title", size = {512, 50}, spacing = 20 },

            -- Spawn Chance Slider (0% to 100%)
            { id = "spawn_chance", type = "track", val = 2, def = 1, min = 0, max = 100, step = 0.5 },

            -- PDA Notification Checkbox Toggle
            { id = "enable_messages", type = "check", val = 1, def = true },

            -- Death Notification Checkbox Toggle
            { id = "enable_death_messages", type = "check", val = 1, def = true },

            -- Generic Message Cooldown Slider (seconds)
            { id = "generic_message_cooldown", type = "track", val = 2, def = 1, min = 0, max = 60, step = 1 },

            -- Debug Info Checkbox Toggle
            { id = "debug_enabled", type = "check", val = 1, def = false },

            -- Map Marker Checkbox Toggle
            { id = "enable_map_markers", type = "check", val = 1, def = true }
        }
    }
    return op
end

-- load mcm settings
function load_settings()
    if ui_mcm then
        spawn_chance = ui_mcm.get("arc_name_replacer/spawn_chance")
        enable_messages = ui_mcm.get("arc_name_replacer/enable_messages")
        enable_death_messages = ui_mcm.get("arc_name_replacer/enable_death_messages") -- was missing, checkbox did nothing without this
        generic_message_cooldown = ui_mcm.get("arc_name_replacer/generic_message_cooldown")
        debug_enabled = ui_mcm.get("arc_name_replacer/debug_enabled")
        enable_map_markers = ui_mcm.get("arc_name_replacer/enable_map_markers")
    end
end

--=====================================================
-- SAVE / LOAD STATE
--=====================================================

-- saving stuff
local function save_state(m_data)
    m_data.ANR_donator_pool = donator_pool
    m_data.ANR_processed_npcs = processed_npcs
    m_data.ANR_renamed_npcs = renamed_npcs
    m_data.ANR_names_loaded = file_found
    m_data.ANR_last_generic_message_time = last_generic_message_time
end

local function load_state(m_data)
    donator_pool = m_data.ANR_donator_pool or donator_pool
    processed_npcs = m_data.ANR_processed_npcs or processed_npcs
    renamed_npcs = m_data.ANR_renamed_npcs or renamed_npcs
    file_found = m_data.ANR_names_loaded or file_found
    last_generic_message_time = m_data.ANR_last_generic_message_time or last_generic_message_time
end

--=====================================================
-- NPC RENAME LOGIC
--=====================================================

-- sends the pda alert
local function notify_rename(chosen_name)
    if not enable_messages then return end

    local special_text = special_messages[chosen_name]
    if special_text then
        -- special names always notify, no cooldown
        news_manager.send_tip(db.actor, special_text, nil, "default", 5000)
        return
    end

    -- generic message, only send if the cooldown has expired
    local current_time = time_global()
    if current_time < last_generic_message_time + (generic_message_cooldown * 1000) then
        return -- still on cooldown, skip the message
    end
    last_generic_message_time = current_time

    local text = generic_messages[math.random(1, #generic_messages)]
    news_manager.send_tip(db.actor, text, nil, "default", 5000)
end

-- does the actual rename roll + rename for one npc
local function try_rename_npc(npc)
    local profile = npc:profile_name() or "" -- open npc profile
	
    -- check if npc is important
    if not is_generic_profile(profile) then
        printf("ANR: Protected Unique NPC found (" .. profile .. "). Skipping donator rename roll.")
        return
    end
	
    if not (file_found and #donator_pool ~= 0) then return end
	
    local roll = math.random() * 100
    if roll > spawn_chance then return end

    local chosen_name = take_random_name()

    -- change npc name
    local sim = alife()
    local se = sim:object(npc:id())
    se:set_character_name(chosen_name)

    renamed_npcs[npc:name()] = { id = npc:id(), chosen_name = chosen_name }

    notify_rename(chosen_name)
end

--=====================================================
-- KILL HANDLING
--=====================================================

-- kill check
local function on_npc_killed(victim, who)
	
    if not victim then return end

    local data = renamed_npcs[victim:name()]
    if not data then return end
	
	remove_marker(victim:id())
    renamed_npcs[victim:name()] = nil

    if not enable_death_messages then return end

    if not (who and who:id() == 0) then return end

    local text = special_kill_messages[data.chosen_name]
    if not text then
        text = generic_kill_messages[math.random(1, #generic_kill_messages)] .. data.chosen_name .. "..."
    end

    news_manager.send_tip(db.actor, text, nil, "default", 5000)
end

--=====================================================
-- DEBUG
--=====================================================

-- prints pool size + cooldown status to the log every 10s while debug is on
local function debug_print()
    if not debug_enabled then return end

    local current_time = time_global()
    if current_time < last_debug_time + 10000 then return end -- only print once every 10 seconds
    last_debug_time = current_time

    local cooldown_remaining = (last_generic_message_time + (generic_message_cooldown * 1000)) - current_time
    if cooldown_remaining < 0 then cooldown_remaining = 0 end

    printf("ANR DEBUG: names remaining in pool: " .. #donator_pool)
    printf("ANR DEBUG: generic message cooldown remaining: " .. (cooldown_remaining / 1000) .. "s (cooldown set to " .. generic_message_cooldown .. "s)")
    printf("ANR DEBUG: enable_messages=" .. tostring(enable_messages) .. " enable_death_messages=" .. tostring(enable_death_messages) .. " spawn_chance=" .. tostring(spawn_chance) .. " file_found=" .. tostring(file_found))
end

--=====================================================
-- SCANNER LOOP
--=====================================================

local function on_npc_spawn(npc)
    if not is_enabled then return end
    if not npc or not IsStalker(npc) or not npc:alive() then return end
	
    local npc_name = npc:name()

    debug_print()

    if not processed_npcs[npc_name] then
        try_rename_npc(npc)
        processed_npcs[npc_name] = true
    end

	
    try_rename_npc(npc)
	
    if renamed_npcs[npc:name()] then
		if is_friendly_or_neutral(npc) then
			add_marker(npc:id())
        end
    end
end

--=====================================================
-- INITIALISATION
--=====================================================

function on_game_start()
	RegisterScriptCallback("npc_on_net_spawn", on_npc_spawn)
    RegisterScriptCallback("npc_on_death_callback", on_npc_killed)
	RegisterScriptCallback("npc_on_fighting_actor", npc_on_fighting_actor)
    RegisterScriptCallback("save_state", save_state)
    RegisterScriptCallback("load_state", load_state)
	RegisterScriptCallback("npc_on_use", npc_on_use)
    load_settings()
    ensure_names_loaded()
	refresh_markers()
	math.randomseed(os.time())
end

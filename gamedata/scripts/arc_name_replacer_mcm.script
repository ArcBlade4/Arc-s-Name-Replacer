    l08u_brainlab         = "Lab X16",
    l10_radar             = "Radar",
    l10_limansk           = "Limansk",
    l10_red_forest        = "Red Forest",
    l10u_bunker           = "Lab X10",
    l11_pripyat           = "Pripyat",
    l12_stancia           = "Chernobyl NPP",

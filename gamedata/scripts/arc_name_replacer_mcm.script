local last_debug_time = 0
local last_poll_time = 0
local gaze_timers = {} 
local spawn_chance = 1
local enable_messages = false
local file_found = false
local is_enabled = true
local enable_death_messages = false
local generic_message_cooldown = 2 
local debug_enabled = false 
local enable_map_markers = true
local MARKER_SPOT_TYPE = "anr_special_location"
local MARKER_HINT = "Someone special"
local SIGHTING_DISTANCE = 10 -- metres, max distance to count as "in radius" (no line of sight needed)
local GAZE_TIME_MS = 2000 -- ms of continuous, unbroken line of sight needed to count as "looked at"
local SIGHTING_POLL_MS = 200 
local full_recovery_done = false
local pending_full_recovery = false


local donator_pool = {} 
local processed_npcs = {}
local renamed_npcs = {}
local last_check_time = 0
local spawn_chance = 1
local enable_messages = false
local file_found = false
local is_enabled = true
local enable_death_messages = false
local last_generic_message_time = 0
local generic_message_cooldown = 2
--[[
    ========================
    MESSAGES AND SPECIAL NAMES
    ========================
]]--

-- special messages
-- edit this to add special messages on rename
local special_messages = {
    ["Arc Blade"]  = "%c[255,72,155,232]Arc: %c[default]\\nKnock knock, guess who?",
    ["BlackSpero"] = "%c[255,72,155,232]Arc: %c[default]\\nYo, there's a renegade in disguise nearby...",
    ["Crocnballs"] = "%c[255,72,155,232]Arc: %c[default]\\nHold up, a croc has dangled into the zone...",
	["BloodsuckerFucker"] = "%c[255,72,155,232]Arc: %c[default]\\nYou would not believe what I just saw...",
	["Veno"] = "%c[255,72,155,232]Arc: %c[default]\\nSo, a doppelganger just showed up...",
}

-- regular confirmation messages
local generic_messages = {
    "%c[255,72,155,232]Arc: %c[default]\\nHeads up, someone special's lurking....",
    "%c[255,72,155,232]Arc: %c[default]\\nSomeone special's out there now, exploring the zone...",
    "%c[255,72,155,232]Arc: %c[default]\\nLooks like a familiar face's nearby...",
}

-- special kill mesages
-- edit this to add special messages on kill
local special_kill_messages = {
    ["Arc Blade"]  = "%c[255,72,155,232]Arc: %c[default]\\nOw, you got me... nice shot.",
    ["BlackSpero"] = "%c[255,72,155,232]Arc: %c[default]\\nRenegade down. One less traitor in the zone.",
    ["Crocnballs"] = "%c[255,72,155,232]Arc: %c[default]\\nThe croc didn't make it...",
	["BloodsuckerFucker"] = "%c[255,72,155,232]Arc: %c[default]\\nPervert down, rest in piss...",
	["Veno"] = "%c[255,72,155,232]Arc: %c[default]\\nIs this foreshadowing?",
}

-- regular kill messages
local generic_kill_messages = {
    "%c[255,72,155,232]Arc: %c[default]\\nHeartless, you killed ",
    "%c[255,72,155,232]Arc: %c[default]\\nWell, that's the end of ",
    "%c[255,72,155,232]Arc: %c[default]\\nRest easy, ",
}

--[[
    ========================
    CODE (DO NOT EDIT)
    ========================
]]--



-- patterns that count as a "generic" npc, safe to rename
local generic_patterns = {
    "default", "regular", "tier", "squad",
    "sim_npc", "alpha", "weak", "normal", "strong"
}



-- load names
local function load_names()
    local engine_root_path = getFS():update_path("$fs_root$", "")
    local file_path = engine_root_path .. "names.txt"
    local file = io.open(file_path, "r")

    if file then -- check if file exists
        printf("VNM: Found names.txt, loading names...")
        for line in file:lines() do -- read all lines
            local clean_name = line:gsub("^%s*(.-)%s*$", "%1")
            if clean_name ~= "" then
                table.insert(donator_pool, clean_name)
            end
        end
        file:close()
        printf("VNM: Successfully loaded " .. #donator_pool .. " names from text file.")
        file_found = true
    else -- error message for if file not found
        printf("VNM: WARNING! names.txt not found. looked here: " .. tostring(file_path))
    end
end

--mcm stuff
function on_mcm_load()
    op = {
        id = "arc_name_replacer",
        sh = true,
        gr = {
            -- Title text banner mapping
            { id = "title", type = "slide", link = "ui_options_slider_player", text = "ui_mcm_arc_name_replacer_title", size = {512, 50}, spacing = 20 },

            -- Spawn Chance Slider (0% to 100%)
            { id = "spawn_chance", type = "track", val = 2, def = 1, min = 0, max = 100, step = 0.5 },

            -- PDA Notification Checkbox Toggle
            { id = "enable_messages", type = "check", val = 1, def = true },

            -- Death Notification Checkbox Toggle
            { id = "enable_death_messages", type = "check", val = 1, def = true },
			
			-- Generic Message Cooldown Slider (seconds)
            { id = "generic_message_cooldown", type = "track", val = 2, def = 2, min = 0, max = 60, step = 1 }
        }
    }
    return op
end

-- load mcm settings
function load_settings()
    if ui_mcm then
        spawn_chance = ui_mcm.get("arc_name_replacer/spawn_chance")
        enable_messages = ui_mcm.get("arc_name_replacer/enable_messages")
        enable_death_messages = ui_mcm.get("arc_name_replacer/enable_death_messages") -- was missing, checkbox did nothing without this
    end
end

-- saving stuff
local function save_state(m_data)
    m_data.vnm_donator_pool = donator_pool
    m_data.vnm_processed_npcs = processed_npcs
    m_data.vnm_renamed_npcs = renamed_npcs
    m_data.vnm_names_loaded = file_found
end

local function load_state(m_data)
    donator_pool = m_data.vnm_donator_pool or donator_pool
    processed_npcs = m_data.vnm_processed_npcs or processed_npcs
    renamed_npcs = m_data.vnm_renamed_npcs or renamed_npcs
    file_found = m_data.vnm_names_loaded or file_found
end

-- makes name load once
local function ensure_names_loaded()
    if not file_found then
        load_names()
    end
end

-- checks profile name against the generic patterns list
local function is_generic_profile(profile)
    for _, pattern in ipairs(generic_patterns) do
        if string.find(profile, pattern) then
            return true
        end
    end
    return false
end

-- grabs a random name from the pool and removes it
local function take_random_name()
    local idx = math.random(#donator_pool) -- pick random index
    local chosen_name = donator_pool[idx] -- get name at that index
    table.remove(donator_pool, idx) -- remove it so it can't be reused
    return chosen_name
end

-- sends the pda alert
local function notify_rename(chosen_name)
    if not enable_messages then return end

    local special_text = special_messages[chosen_name]
    if special_text then
        news_manager.send_tip(db.actor, special_text, nil, "default", 5000)
        return
    end

    local current_time = time_global()
    if current_time < last_generic_message_time + (generic_message_cooldown * 1000) then
        return -- still on cooldown, skip the message
    end
    last_generic_message_time = current_time

    local text = generic_messages[math.random(1, #generic_messages)]
    news_manager.send_tip(db.actor, text, nil, "default", 5000)
end

-- does the actual rename roll + rename for one npc
local function try_rename_npc(npc)
    local profile = npc:profile_name() or "" -- open npc profile

    -- check if npc is important
    if not is_generic_profile(profile) then
        printf("VNM: Protected Unique NPC found (" .. profile .. "). Skipping donator rename roll.")
        return
    end

    if not (file_found and #donator_pool ~= 0) then return end

    local roll = math.random() * 100
    if roll > spawn_chance then return end

    local chosen_name = take_random_name()

    -- change npc name
    local sim = alife()
    local se = sim:object(npc:id())
    se:set_character_name(chosen_name)

    renamed_npcs[npc:name()] = chosen_name

    notify_rename(chosen_name)
end

-- kill check
local function on_npc_killed(victim, who)
    if not victim then return end

    local chosen_name = renamed_npcs[victim:name()]
    if not chosen_name then return end

    renamed_npcs[victim:name()] = nil

    if not enable_death_messages then return end

    if not (who and who:id() == 0) then return end 

    local text = special_kill_messages[chosen_name]
    if not text then
        text = generic_kill_messages[math.random(1, #generic_kill_messages)] .. chosen_name .. "..."
    end

    news_manager.send_tip(db.actor, text, nil, "default", 5000)
end

-- npc scanner
function execute_scanner_loop()
    if not is_enabled then return end

    local current_time = time_global()

    if (current_time < last_check_time + 2000) then return end
    last_check_time = current_time

    -- check all ids
    for id = 1, 65534 do
        if not processed_npcs[id] then
            local npc = level.object_by_id(id) 
            -- check if npc is a stalker and is alive
            if npc and IsStalker(npc) and npc:alive() then
				local npc_name = npc:name()
				if not processed_npcs[npc_name] then
					processed_npcs[npc_name] = true
					try_rename_npc(npc)
				end
			end
        end
    end
end

-- Initialisation
function on_game_start()
    RegisterScriptCallback("actor_on_update", execute_scanner_loop)
    RegisterScriptCallback("npc_on_death_callback", on_npc_killed)
    RegisterScriptCallback("save_state", save_state)
    RegisterScriptCallback("load_state", load_state)
    load_settings()
    ensure_names_loaded()
end

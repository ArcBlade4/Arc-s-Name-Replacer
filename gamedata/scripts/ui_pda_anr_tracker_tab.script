-- ANR PDA Tracker Tab (UI only)
-- Data comes from arc_name_replacer_mcm.get_tracker_rows().
-- Registered with Mod App Creator in arc_name_replacer_mcm.on_game_start.

local LAYOUT = {
    WINDOW_W = 1024,
    WINDOW_H = 768,
    ROW_W    = 780,
    ROW_H    = 58,
    ICON     = 48,   -- portrait size (square)
}

-- only this many rows are ever built as widgets at once
local PAGE_SIZE = 9
-- how often the underlying data is re-fetched while the tab is open
local DATA_REFRESH_MS = 5000
local SEARCH_DEBOUNCE_MS = 200


local ANR_exc_key_btns = {
    [DIK_keys.DIK_LSHIFT] = true,
    [DIK_keys.DIK_RSHIFT] = true,
}

local FACTION_PATCHES = {
}

local DIVIDER_COLOR = GetARGB(70, 200, 200, 200)
local SEARCH_OUTLINE_COLOR = GetARGB(180, 150, 150, 150)


local function attach_bar(parent, x1, y1, x2, y2, color)
    local bar = CUIStatic()
    bar:SetAutoDelete(true)
    bar:SetWndRect(Frect():set(x1, y1, x2, y2))
    bar:InitTexture("ui\\ui_noise")
    bar:SetStretchTexture(true)
    bar:SetTextureColor(color)
    parent:AttachChild(bar)
    return bar
end


local function attach_outline(parent, x, y, w, h, color)
    attach_bar(parent, x - 1, y - 1, x + w + 1, y,     color) -- top
    attach_bar(parent, x - 1, y + h, x + w + 1, y + h + 1, color) -- bottom
    attach_bar(parent, x - 1, y - 1, x,     y + h + 1, color) -- left
    attach_bar(parent, x + w, y - 1, x + w + 1, y + h + 1, color) -- right
end

-- base label for each sortable column; the active sort gets an arrow suffix
local HEADER_LABELS = {
    name = "Name",
    status = "Status",
    seen = "Last Seen",
}

local xml = CScriptXmlInit()
xml:ParseFile("pda_anr_tracker.xml")

--=====================================================
-- List row
--=====================================================

class "anr_tracker_row" (CUIListBoxItem)

function anr_tracker_row:__init(row)
    super()
    self:SetWndRect(Frect():set(0, 0, LAYOUT.ROW_W, LAYOUT.ROW_H))

    -- portrait (skipped if we never captured one)
    if row.icon then
        self.portrait = xml:InitStatic("row_icon", self)
        self.portrait:InitTexture(row.icon)
        self.portrait:SetStretchTexture(true)
    end

    -- faction patch overlay: only when this stalker's community has an explicit,
    -- non-empty entry in FACTION_PATCHES. No entry = no patch, no default.
    local patch_tex = nil
    if row.community then
        local t = rawget(FACTION_PATCHES, row.community)
        if type(t) == "string" and t ~= "" then patch_tex = t end
    end
    if patch_tex and self.portrait then
        self.patch = xml:InitStatic("row_patch", self)
        self.patch:InitTexture(patch_tex)
        self.patch:SetStretchTexture(true)
    end

    self.name = xml:InitTextWnd("row_name", self)
    self.name:SetText(row.name)

    self.faction = xml:InitTextWnd("row_faction", self)
    self.faction:SetText(row.faction_text)

    self.status = xml:InitTextWnd("row_status", self)
    self.status:SetText(row.status_text)
    local c = row.color
    self.status:SetTextColor(GetARGB(c[1], c[2], c[3], c[4]))

    self.rank = xml:InitTextWnd("row_rank", self)
    self.rank:SetText(row.rank_text)

    self.seen = xml:InitTextWnd("row_seen", self)
    self.seen:SetText(row.seen_text)

    self.level = xml:InitTextWnd("row_level", self)
    self.level:SetText(row.level_text)

    -- divider line along the bottom edge of the row
    local d = CUIStatic()
    d:SetAutoDelete(true)
    d:SetWndRect(Frect():set(0, LAYOUT.ROW_H - 2, LAYOUT.ROW_W, LAYOUT.ROW_H - 1))
    d:InitTexture("ui\\ui_noise")
    d:SetStretchTexture(true)
    d:SetTextureColor(DIVIDER_COLOR)
    self:AttachChild(d)
end

--=====================================================
-- Tab
--=====================================================

local instance = nil

class "pda_anr_tracker_tab" (CUIScriptWnd)

function pda_anr_tracker_tab:__init()
    super()
    self._pending_search = false
    self._search_changed_at = nil
    self._rows = nil       -- cached, sorted row list from the data script
    self._rows_at = 0      -- time_global() of the last data fetch
    self.page = 1
    self.sort_key = "name" -- "name" | "status" | "seen"
    self.sort_ascending = true
    self.search_text = ""
    self.locked = false    -- search box armed/disarmed state
    self.removelet = false -- pending "doubled capital letter" fixup
    self:InitControls()
end

function pda_anr_tracker_tab:InitControls()
    self:SetWndRect(Frect():set(0, 0, LAYOUT.WINDOW_W, LAYOUT.WINDOW_H))

    self.frame = xml:InitStatic("frame_main", self)
    xml:InitTextWnd("title", self.frame)

    self.search_box = xml:InitEditBox("search_box", self.frame)
    self:Register(self.search_box, "search_box")

    self.search_lock_btn = xml:Init3tButton("search_lock_btn", self.frame)
    self:Register(self.search_lock_btn, "search_lock_btn")
    self:AddCallback("search_lock_btn", ui_events.BUTTON_CLICKED, self.OnClickSearchLock, self)


    self.btn_refresh = xml:Init3tButton("btn_refresh", self.frame)
    self:Register(self.btn_refresh, "btn_refresh")
    self:AddCallback("btn_refresh", ui_events.BUTTON_CLICKED, self.OnClickRefresh, self)

    attach_outline(self.frame, 390, 10, 210, 24, SEARCH_OUTLINE_COLOR)


    self.search_placeholder = xml:InitTextWnd("search_placeholder", self.frame)


    self.header_name = xml:Init3tButton("header_name", self.frame)
    self:Register(self.header_name, "header_name")
    self:AddCallback("header_name", ui_events.BUTTON_CLICKED, self.OnHeaderName, self)

    self.header_status = xml:Init3tButton("header_status", self.frame)
    self:Register(self.header_status, "header_status")
    self:AddCallback("header_status", ui_events.BUTTON_CLICKED, self.OnHeaderStatus, self)

    self.header_seen = xml:Init3tButton("header_seen", self.frame)
    self:Register(self.header_seen, "header_seen")
    self:AddCallback("header_seen", ui_events.BUTTON_CLICKED, self.OnHeaderSeen, self)

    self.list = xml:InitListBox("tracker_list", self.frame)
    self:Register(self.list, "tracker_list")

    self.empty_text = xml:InitTextWnd("empty_text", self.frame)
    self.empty_text:Show(false)

    -- paging controls
    self.page_text = xml:InitTextWnd("page_text", self.frame)

    self.btn_prev = xml:Init3tButton("btn_prev", self.frame)
    self:Register(self.btn_prev, "btn_prev")
    self:AddCallback("btn_prev", ui_events.BUTTON_CLICKED, self.OnClickPrev, self)

    self.btn_next = xml:Init3tButton("btn_next", self.frame)
    self:Register(self.btn_next, "btn_next")
    self:AddCallback("btn_next", ui_events.BUTTON_CLICKED, self.OnClickNext, self)

    self:RefreshHeaderLabels()
    self:Populate(true)
end

function pda_anr_tracker_tab:RefreshHeaderLabels()
    local arrow = self.sort_ascending and " ^" or " v"
    self.header_name:TextControl():SetText(HEADER_LABELS.name .. (self.sort_key == "name" and arrow or ""))
    self.header_status:TextControl():SetText(HEADER_LABELS.status .. (self.sort_key == "status" and arrow or ""))
    self.header_seen:TextControl():SetText(HEADER_LABELS.seen .. (self.sort_key == "seen" and arrow or ""))
end

function pda_anr_tracker_tab:SetSort(sort_key)
    if self.sort_key == sort_key then
        self.sort_ascending = not self.sort_ascending
    else
        self.sort_key = sort_key
        self.sort_ascending = true
    end
    self:RefreshHeaderLabels()
    self.page = 1
    self:Populate(true)
end

function pda_anr_tracker_tab:OnHeaderName()
    self:SetSort("name")
end

function pda_anr_tracker_tab:OnHeaderStatus()
    self:SetSort("status")
end

function pda_anr_tracker_tab:OnHeaderSeen()
    self:SetSort("seen")
end

function pda_anr_tracker_tab:OnClickRefresh()
    self:DisarmSearch() -- make sure the search box isn't holding input
    -- full world scan: adds every renamed stalker to the tracker, including
    -- ones the player never saw. Heavy (loops every server object), so it only
    -- runs on this button, never on the periodic refresh.
    local ok, err = pcall(arc_name_replacer_mcm.manual_recovery)
    if not ok then
        printf("ANR: manual recovery failed: %s", tostring(err))
    end
    self:Populate(true)
end

function pda_anr_tracker_tab:OnClickPrev()
    self.page = self.page - 1
    self:Populate(false)
end

function pda_anr_tracker_tab:OnClickNext()
    self.page = self.page + 1
    self:Populate(false)
end

--=====================================================
-- Search box arm/disarm
--=====================================================

function pda_anr_tracker_tab:ArmSearch()
    if self.locked then return end
    self.locked = true
    self.search_box:CaptureFocus(true)
end

function pda_anr_tracker_tab:DisarmSearch()
    if not self.locked then return end
    self.locked = false
    self.removelet = false
    self.search_box:CaptureFocus(false)
    RemoveTimeEvent("anr_delay_input_unlock", "anr_delay_input_unlock")
end

function pda_anr_tracker_tab:OnClickSearchLock()
    if self.locked then
        self:DisarmSearch()
    else
        self:ArmSearch()
    end
end

local function anr_block_input()
    CreateTimeEvent("anr_delay_input_unlock", "anr_delay_input_unlock", 0.01, function()
        level.disable_input()
        level.enable_input()
    end)
end

local function anr_search_active()
    if not (instance and instance.locked) then return false end
    if not get_console_cmd(1, "g_3d_pda") then return false end
    local pda = ActorMenu.get_pda_menu()
    return pda:IsShown() and pda:GetActiveSection() == "eptAnrTracker"
end

-- fires BEFORE the engine processes the key
function on_before_key_press(key, action, dis, flags)
    if not instance then return end
    if not get_console_cmd(1, "g_3d_pda") then return end

    local pda = ActorMenu.get_pda_menu()
    if pda:GetActiveSection() ~= "eptAnrTracker" then return end

    if not instance.locked then
        instance.search_box:CaptureFocus(false)
        RemoveTimeEvent("anr_delay_input_unlock", "anr_delay_input_unlock")
        return
    end


    if key == DIK_keys.DIK_ESCAPE or key == DIK_keys.DIK_RETURN or key == DIK_keys.DIK_NUMPADENTER then
        instance:DisarmSearch()
        if flags then flags.ret_value = false end
        return
    end

    anr_block_input()

    if instance.removelet then -- roundway to fix doubling of capital letters
        instance.removelet = false
        local text = instance.search_box:GetText() or ""
        if #text > 0 then
            instance.search_box:SetText(string.sub(text, 1, -2))
        end
    end

    if ANR_exc_key_btns[key] then
        instance.removelet = true
    end

    -- block everything (PDA close, holster, lean, sprint, etc.)
    if flags then flags.ret_value = false end
end

local anr_on_key_release_original = bind_stalker_ext.on_key_release
function bind_stalker_ext.on_key_release(binder, key)
    if anr_search_active() then return false end
    return anr_on_key_release_original(binder, key)
end

function on_before_save_input(flags)
    if anr_search_active() and flags then flags.ret = true end
end

-- drop the lock if the player leaves the tab or closes the PDA while armed
function anr_on_update()
    if instance and instance.locked then
        local pda = ActorMenu.get_pda_menu()
        if not (pda:IsShown() and pda:GetActiveSection() == "eptAnrTracker") then
            instance:DisarmSearch()
        end
    end
end

function on_game_start()
    RegisterScriptCallback("on_before_key_press", on_before_key_press)
    RegisterScriptCallback("on_before_save_input", on_before_save_input)
    RegisterScriptCallback("actor_on_update", anr_on_update)
end

-- refetch = true re-pulls + re-sorts the data from the data script.
-- refetch = false reuses the cached rows (paging, search filtering).
-- Only the rows on the current page are turned into widgets, and only
-- those rows get their display text built (finalize_tracker_row).
function pda_anr_tracker_tab:Populate(refetch)
    if refetch or not self._rows then
        self._rows = arc_name_replacer_mcm.get_tracker_rows(self.sort_key, self.sort_ascending)
        self._rows_at = time_global()
    end

    local rows = self._rows

    if self.search_text ~= "" then
        local needle = self.search_text:lower()
        local filtered = {}
        for _, row in ipairs(rows) do
            if row.name:lower():find(needle, 1, true) then
                filtered[#filtered + 1] = row
            end
        end
        rows = filtered
    end

    local total = #rows
    local pages = math.max(1, math.ceil(total / PAGE_SIZE))
    if self.page > pages then self.page = pages end
    if self.page < 1 then self.page = 1 end

    self.list:RemoveAll()
    self.empty_text:Show(total == 0)

    local first = (self.page - 1) * PAGE_SIZE + 1
    local last = math.min(total, first + PAGE_SIZE - 1)
    for i = first, last do
        local row = arc_name_replacer_mcm.finalize_tracker_row(rows[i])
        self.list:AddExistingItem(anr_tracker_row(row))
    end

    self.page_text:SetText(self.page .. " / " .. pages)
    self.btn_prev:Enable(self.page > 1)
    self.btn_next:Enable(self.page < pages)
end

function pda_anr_tracker_tab:Update()
    CUIScriptWnd.Update(self)

    local current_search = self.search_box:GetText() or ""

    self.search_placeholder:Show(current_search == "")

    local now = time_global()

    if current_search ~= self.search_text then
        -- text changed: remember it, but don't rebuild the list yet
        self.search_text = current_search
        self._pending_search = true
        self._search_changed_at = now
        return
    end

    if self._pending_search then
        if now - self._search_changed_at > SEARCH_DEBOUNCE_MS then
            self._pending_search = false
            self.page = 1
            self:Populate(false)
        end
        return
    end

    -- periodic data refresh (cheap now: only PAGE_SIZE rows get built)
    if now - self._rows_at > DATA_REFRESH_MS then
        self:Populate(true)
    end
end

--=====================================================
-- Singleton access
--=====================================================

function get_ui()
    if not instance then
        instance = pda_anr_tracker_tab()
    end
    return instance
end
